# 部署配置（本地环境，不入库）
# 复制为 deploy/deploy.env 后按实际情况改。release.sh / bootstrap.sh 会自动读取。
# Git-Bash 下路径写法；这里只放「连哪台机器」，不含任何密码。

ZLB_HOST=82.156.84.127

# ssh 用户。ubuntu 用户不是 root，安装/重启 systemd 需 sudo（脚本已处理）
ZLB_USER=ubuntu

ZLB_PORT=22
ZLB_REMOTE_DIR=/opt/zouliangbu-server
ZLB_SERVICE=zouliangbu-server
ZLB_KEY=$HOME/.ssh/id_ed25519

# 远端提权命令。ubuntu 用户免密 sudo 时用 sudo；若配了 NOPASSWD 也一样是 sudo
ZLB_SUDO=sudo
