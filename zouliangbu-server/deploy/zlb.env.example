# 线上运行配置（/opt/zouliangbu-server/zlb.env，chmod 600）
# 由 deploy/bootstrap.sh 生成，之后手改这个文件即可，重新发布不会覆盖。
#
# Spring 宽松绑定：配置项 admin.password ←→ 环境变量 ADMIN_PASSWORD（单下划线）

# ---- 数据库 ----
# 当前用 SQLite 单文件库：零依赖、重启不丢、备份就是拷一个文件。
# 之前线上跑的是 H2 内存库（jdbc:h2:mem:zlb），每次重启数据全清。
SPRING_PROFILES_ACTIVE=dev
SQLITE_PATH=/opt/zouliangbu-server/zlb.db

# 以后换 MySQL 就把上面两行换成下面四行（并导入现有数据）：
# SPRING_PROFILES_ACTIVE=prod
# DATABASE_URL=jdbc:mysql://127.0.0.1:3306/zouliangbu?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
# DATABASE_USER=zlb
# DATABASE_PASSWORD=CHANGE_ME

# ---- 后台 ----
ADMIN_PASSWORD=CHANGE_ME

# ---- 上传 ----
ADMIN_UPLOAD_DIR=/opt/zouliangbu-server/uploads
ADMIN_UPLOAD_PUBLIC_PREFIX=/uploads
