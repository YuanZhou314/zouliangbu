[Unit]
Description=zouliangbu content API (Spring Boot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 用 ubuntu：服务器上该用户已存在，且 /usr/bin/java 现成可用，无需另装 JDK
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/zouliangbu-server

Environment=TZ=Asia/Shanghai
# 数据库密码、profile、后台密码放这个文件（chmod 600），不要写进 unit
EnvironmentFile=/opt/zouliangbu-server/zlb.env

ExecStart=/usr/bin/java \
    -XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError \
    -Duser.timezone=Asia/Shanghai -Dfile.encoding=UTF-8 \
    -jar /opt/zouliangbu-server/current/app.jar --server.port=8080

# 优雅停机：先 SIGTERM，Spring 会关闭线程池和连接池
KillSignal=SIGTERM
TimeoutStopSec=30

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
